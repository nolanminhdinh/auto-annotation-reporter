# ==============================================================================
# Auto Annotation Report Pipeline - Environment Configuration
# ==============================================================================

# --- CVAT Configuration ---
# URL máy chủ CVAT (không có dấu gạch chéo cuối)
CVAT_HOST=https://cvat.example.org

# Xác thực bằng Personal Access Token (Khuyên dùng)
CVAT_TOKEN=your_cvat_personal_access_token_here

# Legacy placeholders; runner hiện dùng CVAT_TOKEN, chưa hỗ trợ đăng nhập user/password.
CVAT_USER=
CVAT_PASS=

# Tổ chức trong CVAT (nếu có, để trống nếu không dùng Org)
CVAT_ORG=

# Task ID mặc định cần quét và tạo báo cáo
CVAT_TASK_ID=217

# --- GitHub Configuration ---
# GitHub Personal Access Token (cần quyền repo hoặc public_repo)
GITHUB_TOKEN=your_github_personal_access_token

# Tên repository (dạng username/repo-name hoặc org/repo-name)
GITHUB_REPO=nolanminhdinh/auto-annotation-reporter

# --- Notification Webhook (Tùy chọn) ---
# Telegram Bot Token và Chat ID để nhận thông báo tự động
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (nếu dùng Discord)
DISCORD_WEBHOOK_URL=

# --- LLM Summarizer Configuration (Tùy chọn) ---
# Mặc định trích xuất offline. Gemini chỉ gọi khi --mode live --summary-provider gemini --llm-summary.
GEMINI_API_KEY=
GEMINI_MODEL=
# Dự phòng cho tích hợp tương lai, chưa dùng trong runner hiện tại.
OPENAI_API_KEY=
