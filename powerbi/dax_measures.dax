Total_Completed_Frames =
COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = "completed"), 0)

Total_Objects_Created =
IF(MAX(report_status[annotations_available]) = 1, COALESCE(COUNTROWS(fact_annotations), 0))

Total_Active_Hours =
IF(COUNTROWS(fact_job_sessions) > 0 && COUNT(fact_job_sessions[active_time_hours]) = COUNTROWS(fact_job_sessions), SUM(fact_job_sessions[active_time_hours]))

Velocity_Frames_Per_Hour =
DIVIDE([Total_Completed_Frames], [Total_Active_Hours])

Velocity_Objects_Per_Hour =
DIVIDE([Total_Objects_Created], [Total_Active_Hours])

Avg_Time_Per_Frame_Mins =
DIVIDE([Total_Active_Hours] * 60, [Total_Completed_Frames])

Avg_Time_Per_Object_Secs =
DIVIDE([Total_Active_Hours] * 3600, [Total_Objects_Created])

First_Time_Pass_Rate =
IF(MAX(report_status[reviews_available]) = 1, DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_iteration] = 1, fact_qa_reviews[review_decision] = "Accepted"), 0), CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_iteration] = 1)))

Rejection_Rate =
IF(MAX(report_status[reviews_available]) = 1, DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_decision] = "Rejected"), 0), COUNTROWS(fact_qa_reviews)))

Total_Defects =
IF(MAX(report_status[defects_available]) = 1, COALESCE(COUNTROWS(fact_qa_defects), 0))

Defect_Density_Per_100F =
IF(COUNTBLANK(fact_qa_defects[review_id]) > 0 || (COUNTROWS(fact_qa_defects) = 0 && COUNTROWS(FILTER(fact_ground_truth_eval, LEFT(fact_ground_truth_eval[eval_id], 8) = "cvat-qa:")) > 0), BLANK(), DIVIDE([Total_Defects] * 100, [Total_Completed_Frames]))

Avg_Defects_Per_Job =
IF(COUNTBLANK(fact_qa_defects[review_id]) > 0 || (COUNTROWS(fact_qa_defects) = 0 && COUNTROWS(FILTER(fact_ground_truth_eval, LEFT(fact_ground_truth_eval[eval_id], 8) = "cvat-qa:")) > 0), DIVIDE([Total_Defects], DISTINCTCOUNT(fact_ground_truth_eval[job_id])), DIVIDE([Total_Defects], DISTINCTCOUNT(fact_qa_reviews[job_id])))

Avg_mIoU_Score =
IF(MAX(report_status[gt_available]) = 1, AVERAGE(fact_ground_truth_eval[mean_iou]))

Avg_F1_Score =
IF(MAX(report_status[gt_available]) = 1, AVERAGE(fact_ground_truth_eval[f1_score]))

Avg_Object_Area_Pixels =
AVERAGE(fact_annotations[area_pixels])

Avg_Area_Frame_Pct =
DIVIDE(AVERAGE(fact_annotations[frame_area_pct]), 100)

Pct_Small_Objects =
DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_annotations), fact_annotations[size_scale] = "Small"), 0), CALCULATE(COUNTROWS(fact_annotations), NOT ISBLANK(fact_annotations[size_scale])))

Count_At_Risk_Annotators =
VAR People = ADDCOLUMNS(VALUES(dim_annotators[annotator_id]), "F", [First_Time_Pass_Rate], "R", [Rejection_Rate], "G", [Avg_F1_Score]) VAR Assessed = FILTER(People, NOT ISBLANK([F]) || NOT ISBLANK([R]) || NOT ISBLANK([G])) RETURN IF(COUNTROWS(Assessed) > 0, COALESCE(COUNTROWS(FILTER(Assessed, (NOT ISBLANK([F]) && [F] < 0.8) || (NOT ISBLANK([R]) && [R] >= 0.2) || (NOT ISBLANK([G]) && [G] < 0.85))), 0))

System_Avg_Velocity =
CALCULATE([Velocity_Frames_Per_Hour], REMOVEFILTERS(dim_annotators))

Project_Progress_Pct =
DIVIDE([Total_Completed_Frames], SUM(dim_tasks_batches[total_frames_target]))

Total_Target_Frames =
SUM(dim_tasks_batches[total_frames_target])

Frames_In_Annotation =
COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = "annotation"), 0)

Frames_In_Validation =
COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = "validation"), 0)

Daily_Completed_Frames =
CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = "completed")

Total_Open_Edge_Cases =
COALESCE(CALCULATE(COUNTROWS(fact_edge_cases), fact_edge_cases[state] = "open"), 0)

Total_Blockers =
COALESCE(CALCULATE(COUNTROWS(fact_edge_cases), fact_edge_cases[state] = "open", fact_edge_cases[severity] = "Blocker"), 0)

Active_Annotators =
COALESCE(COUNTROWS(FILTER(VALUES(dim_annotators[annotator_id]), NOT ISBLANK(dim_annotators[annotator_id]) && CALCULATE(COUNTROWS(fact_job_sessions)) > 0)), 0)

Source_Label =
IF(CONTAINSSTRING(MAX(report_status[warnings]), "SIMULATED_SUPPLEMENT"), "MÔ PHỎNG ĐẦY ĐỦ / KHÔNG PHẢI KẾT QUẢ VẬN HÀNH THẬT", IF(MAX(report_status[is_demo]) = 1, "DEMO / DỮ LIỆU GIẢ LẬP", "DỮ LIỆU NGUỒN")) & "  |  " & FORMAT(MAX(report_status[as_of]), "dd/MM/yyyy")

Data_Warnings =
IF(CONTAINSSTRING(MAX(report_status[warnings]), "SIMULATED_SUPPLEMENT"), "DỮ LIỆU MÔ PHỎNG: nhân sự, giờ làm, review, lỗi, GT và ngày hoàn thành đều phục vụ kiểm thử." & UNICHAR(10) & "Không dùng để đánh giá người thật. Link CVAT chỉ tham chiếu bộ ảnh; không phản ánh trạng thái mô phỏng local.", "Nguồn: " & IF(ISBLANK([Total_Active_Hours]), "chưa có giờ làm → chưa tính vận tốc/AHT", "có giờ làm") & " | " & IF(MAX(report_status[reviews_available]) = 1, "có lịch sử review", "chưa có lịch sử review → chưa tính FTPR/rejection") & UNICHAR(10) & IF(MAX(report_status[gt_available]) = 1, "QA/F1 có nguồn; ", "Chưa có QA/F1; ") & IF(ISBLANK([Avg_mIoU_Score]), "mIoU chưa có nguồn hình học. ", "") & "QA tự động theo mẫu không thay thế review; mật độ lỗi/frame hoàn thành để trống nếu khác phạm vi.")

Selected_Case =
SELECTEDVALUE(fact_edge_cases[description], "Chọn một ca trong bảng phía trên để đọc mô tả. Link example.org trong bản DEMO chỉ dùng minh họa.")

Annotator_Segment =
IF(HASONEVALUE(dim_annotators[annotator_id]) && NOT ISBLANK(SELECTEDVALUE(dim_annotators[annotator_id])), (VAR V = [Velocity_Frames_Per_Hour] VAR F = [First_Time_Pass_Rate] VAR R = [Rejection_Rate] VAR G = [Avg_F1_Score] VAR Known = NOT ISBLANK(F) || NOT ISBLANK(R) || NOT ISBLANK(G) VAR Risk = (NOT ISBLANK(F) && F < .8) || (NOT ISBLANK(R) && R >= .2) || (NOT ISBLANK(G) && G < .85) RETURN SWITCH(TRUE(), ISBLANK(V) || NOT Known, "Insufficient data", Risk && V >= 60, "Fast and faulty", Risk && V < 20, "Needs retraining", Risk, "Needs QA support", V < 20, "Slow but steady", V >= 40, "Star annotator", "Core performer")))