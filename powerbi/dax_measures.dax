/* ==============================================================================
   BỘ 20 DAX MEASURES CHUẨN HÓA CHO POWER BI DASHBOARD
   Dự án: Auto Annotation Reporter (CVAT - GitHub - Power BI)
   Tác giả: Đinh Công Minh (Project Lead) & Phạm Nguyễn Tuân (ETL Processors)
   Tương thích: 100% với Python metrics-etl-processors & Data Contract v1
   ============================================================================== */

// ==============================================================================
// NHÓM 1: TIẾN ĐỘ & VẬN TỐC (PROGRESS & VELOCITY)
// ==============================================================================

// 1. Tổng số Frame đã hoàn thành kiểm định
Total_Completed_Frames = 
CALCULATE(
    SUM(fact_job_sessions[total_frames]),
    fact_job_sessions[status] = "completed"
)

// 2. Tổng số đối tượng (boxes, polygons, tracks) đã vẽ
Total_Objects_Created = 
COUNTROWS(fact_annotations)

// 3. Tổng thời gian thao tác thực tế (Active Hours)
Total_Active_Hours = 
SUM(fact_job_sessions[active_time_hours])

// 4. Vận tốc gán nhãn theo frame (Frames/giờ)
Velocity_Frames_Per_Hour = 
DIVIDE([Total_Completed_Frames], [Total_Active_Hours], BLANK())

// 5. Vận tốc gán nhãn theo đối tượng (Objects/giờ)
Velocity_Objects_Per_Hour = 
DIVIDE([Total_Objects_Created], [Total_Active_Hours], BLANK())

// 6. Thời gian xử lý trung bình 1 khung hình (Phút/frame)
Avg_Time_Per_Frame_Mins = 
DIVIDE([Total_Active_Hours] * 60, [Total_Completed_Frames], BLANK())

// 7. Thời gian vẽ trung bình 1 đối tượng (Giây/object)
Avg_Time_Per_Object_Secs = 
DIVIDE([Total_Active_Hours] * 3600, [Total_Objects_Created], BLANK())


// ==============================================================================
// NHÓM 2: CHẤT LƯỢNG & QA/QC (QUALITY ASSURANCE)
// ==============================================================================

// 8. Tỷ lệ duyệt ngay vòng đầu (First-Time Pass Rate - FTPR)
First_Time_Pass_Rate = 
DIVIDE(
    CALCULATE(
        COUNTROWS(fact_qa_reviews),
        fact_qa_reviews[review_iteration] = 1,
        fact_qa_reviews[review_decision] = "Accepted"
    ),
    CALCULATE(
        COUNTROWS(fact_qa_reviews),
        fact_qa_reviews[review_iteration] = 1
    ),
    BLANK()
)

// 9. Tỷ lệ trả về làm lại (Rejection Rate)
Rejection_Rate = 
DIVIDE(
    CALCULATE(
        COUNTROWS(fact_qa_reviews),
        fact_qa_reviews[review_decision] = "Rejected"
    ),
    COUNTROWS(fact_qa_reviews),
    BLANK()
)

// 10. Tổng số lỗi do Reviewer ghi nhận
Total_Defects = 
COUNTROWS(fact_qa_defects)

// 11. Mật độ lỗi trên 100 khung hình (Defect Density per 100 frames)
Defect_Density_Per_100F = 
DIVIDE([Total_Defects] * 100, [Total_Completed_Frames], BLANK())

// 12. Số lỗi trung bình trên mỗi Job thẩm định
Avg_Defects_Per_Job = 
DIVIDE(
    [Total_Defects],
    DISTINCTCOUNT(fact_qa_reviews[job_id]),
    BLANK()
)

// 13. Điểm mIoU trung bình khi đối chiếu Ground Truth
Avg_mIoU_Score = 
AVERAGE(fact_ground_truth_eval[mean_iou])

// 14. Điểm F1-Score trung bình khi đối chiếu Ground Truth
Avg_F1_Score = 
AVERAGE(fact_ground_truth_eval[f1_score])


// ==============================================================================
// NHÓM 3: HÌNH HỌC & PHÂN BỔ DỮ LIỆU (GEOMETRY & DATA DISTRIBUTION)
// ==============================================================================

// 15. Diện tích vật thể trung bình (Pixels)
Avg_Object_Area_Pixels = 
AVERAGE(fact_annotations[area_pixels])

// 16. Tỷ lệ chiếm dụng khung hình trung bình (0-1, format %)
Avg_Area_Frame_Pct = 
DIVIDE(
    AVERAGE(fact_annotations[frame_area_pct]),
    100,
    BLANK()
)

// 17. Tỷ lệ vật thể nhỏ (COCO Small Scale < 1024 px²)
Pct_Small_Objects = 
DIVIDE(
    CALCULATE(
        COUNTROWS(fact_annotations),
        fact_annotations[size_scale] = "Small"
    ),
    [Total_Objects_Created],
    BLANK()
)


// ==============================================================================
// NHÓM 4: PHÂN KHÚC NHÂN SỰ & QUẢN TRỊ RỦI RO (ANNOTATOR MATRIX & RISK)
// ==============================================================================

// 18. Số lượng nhân sự rủi ro cao (Rejection >= 20% hoặc FTPR < 80%)
Count_At_Risk_Annotators = 
CALCULATE(
    DISTINCTCOUNT(fact_job_sessions[annotator_id]),
    FILTER(
        dim_annotators,
        [Rejection_Rate] >= 0.20 || ([First_Time_Pass_Rate] > 0 && [First_Time_Pass_Rate] < 0.80)
    )
)


// ==============================================================================
// NHÓM 5: BENCHMARK TOÀN DỰ ÁN & TIẾN ĐỘ TỔNG (PROJECT BENCHMARK & PROGRESS)
// ==============================================================================

// 19. Vận tốc trung bình toàn hệ thống (Bỏ lọc cá nhân)
System_Avg_Velocity = 
CALCULATE(
    [Velocity_Frames_Per_Hour],
    ALL(dim_annotators)
)

// 20. Tỷ lệ tiến độ toàn dự án (% hoàn thành mục tiêu)
Project_Progress_Pct = 
DIVIDE(
    [Total_Completed_Frames],
    SUM(dim_tasks_batches[total_frames_target]),
    BLANK()
)


// ==============================================================================
// MEASURES BỔ TRỢ CHO 5 TRANG BÁO CÁO (SUPPORTING MEASURES)
// ==============================================================================

// Tổng số ca khó đang mở (Open Edge Cases)
Total_Open_Edge_Cases = 
CALCULATE(
    COUNTROWS(fact_edge_cases),
    fact_edge_cases[state] = "open"
)

// Tổng số ca nghiêm trọng / Blocker
Total_Blockers = 
CALCULATE(
    COUNTROWS(fact_edge_cases),
    fact_edge_cases[severity] = "Blocker"
)

// Số khung hình còn lại cần hoàn thành
Target_Remaining_Frames = 
MAX(
    0,
    SUM(dim_tasks_batches[total_frames_target]) - [Total_Completed_Frames]
)
