model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_annotators", "dim_reviewers", "dim_tasks_batches", "dim_classes_labels", "dim_date", "dim_jobs", "fact_job_sessions", "fact_annotations", "fact_qa_reviews", "fact_qa_defects", "fact_ground_truth_eval", "fact_edge_cases", "report_status", "kpi_reconciliation"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_annotators
ref table dim_reviewers
ref table dim_tasks_batches
ref table dim_classes_labels
ref table dim_date
ref table dim_jobs
ref table fact_job_sessions
ref table fact_annotations
ref table fact_qa_reviews
ref table fact_qa_defects
ref table fact_ground_truth_eval
ref table fact_edge_cases
ref table report_status
ref table kpi_reconciliation

ref cultureInfo en-US

