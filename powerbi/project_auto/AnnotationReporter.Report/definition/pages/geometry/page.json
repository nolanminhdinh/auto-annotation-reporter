{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "geometry",
  "displayName": "04 Hình học",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1440,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F3F6FB'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "pageRefresh": [
      {
        "properties": {
          "show": {
            "expr": {
              "Literal": {
                "Value": "true"
              }
            }
          },
          "duration": {
            "expr": {
              "Literal": {
                "Value": "'PT10S'"
              }
            }
          }
        }
      }
    ]
  }
}