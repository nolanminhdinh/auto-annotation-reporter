{
  "name": "AnnotationReporter",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "expression": "\"C:\\Users\\MINH\\vinai\\Build phase\\data\\processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "dim_annotators",
        "columns": [
          {
            "name": "annotator_id",
            "dataType": "string",
            "sourceColumn": "annotator_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_name",
            "dataType": "string",
            "sourceColumn": "full_name",
            "summarizeBy": "none"
          },
          {
            "name": "username",
            "dataType": "string",
            "sourceColumn": "username",
            "summarizeBy": "none"
          },
          {
            "name": "role",
            "dataType": "string",
            "sourceColumn": "role",
            "summarizeBy": "none"
          },
          {
            "name": "joined_date",
            "dataType": "dateTime",
            "sourceColumn": "joined_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          }
        ],
        "partitions": [
          {
            "name": "dim_annotators",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_annotators.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"annotator_id\", type text}, {\"full_name\", type text}, {\"username\", type text}, {\"role\", type text}, {\"joined_date\", type date}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_reviewers",
        "columns": [
          {
            "name": "reviewer_id",
            "dataType": "string",
            "sourceColumn": "reviewer_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "full_name",
            "dataType": "string",
            "sourceColumn": "full_name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_reviewers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_reviewers.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"reviewer_id\", type text}, {\"full_name\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_tasks_batches",
        "columns": [
          {
            "name": "task_id",
            "dataType": "int64",
            "sourceColumn": "task_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "batch_id",
            "dataType": "string",
            "sourceColumn": "batch_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "task_name",
            "dataType": "string",
            "sourceColumn": "task_name",
            "summarizeBy": "none"
          },
          {
            "name": "total_frames_target",
            "dataType": "int64",
            "sourceColumn": "total_frames_target",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_tasks_batches",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_tasks_batches.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"task_id\", Int64.Type}, {\"batch_id\", type text}, {\"task_name\", type text}, {\"total_frames_target\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_classes_labels",
        "columns": [
          {
            "name": "label_key",
            "dataType": "string",
            "sourceColumn": "label_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "label_id",
            "dataType": "int64",
            "sourceColumn": "label_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "task_id",
            "dataType": "int64",
            "sourceColumn": "task_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "label_name",
            "dataType": "string",
            "sourceColumn": "label_name",
            "summarizeBy": "none"
          },
          {
            "name": "color_hex",
            "dataType": "string",
            "sourceColumn": "color_hex",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_classes_labels",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_classes_labels.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"label_key\", type text}, {\"label_id\", Int64.Type}, {\"task_id\", Int64.Type}, {\"label_name\", type text}, {\"color_hex\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_date",
        "columns": [
          {
            "name": "date_key",
            "dataType": "dateTime",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none"
          },
          {
            "name": "month_num",
            "dataType": "int64",
            "sourceColumn": "month_num",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          },
          {
            "name": "day_name",
            "dataType": "string",
            "sourceColumn": "day_name",
            "summarizeBy": "none"
          },
          {
            "name": "week_num",
            "dataType": "int64",
            "sourceColumn": "week_num",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_date.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"date_key\", type date}, {\"year\", Int64.Type}, {\"month_num\", Int64.Type}, {\"month_name\", type text}, {\"day_name\", type text}, {\"week_num\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_jobs",
        "columns": [
          {
            "name": "job_id",
            "dataType": "int64",
            "sourceColumn": "job_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "task_id",
            "dataType": "int64",
            "sourceColumn": "task_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "annotator_id",
            "dataType": "string",
            "sourceColumn": "annotator_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "stage",
            "dataType": "string",
            "sourceColumn": "stage",
            "summarizeBy": "none"
          },
          {
            "name": "state",
            "dataType": "string",
            "sourceColumn": "state",
            "summarizeBy": "none"
          },
          {
            "name": "frame_count",
            "dataType": "int64",
            "sourceColumn": "frame_count",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_jobs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\dim_jobs.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"job_id\", Int64.Type}, {\"task_id\", Int64.Type}, {\"annotator_id\", type text}, {\"stage\", type text}, {\"state\", type text}, {\"frame_count\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fact_job_sessions",
        "columns": [
          {
            "name": "job_id",
            "dataType": "int64",
            "sourceColumn": "job_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "task_id",
            "dataType": "int64",
            "sourceColumn": "task_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "annotator_id",
            "dataType": "string",
            "sourceColumn": "annotator_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "date_key",
            "dataType": "dateTime",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "total_frames",
            "dataType": "int64",
            "sourceColumn": "total_frames",
            "summarizeBy": "none"
          },
          {
            "name": "total_objects",
            "dataType": "int64",
            "sourceColumn": "total_objects",
            "summarizeBy": "none"
          },
          {
            "name": "active_time_hours",
            "dataType": "double",
            "sourceColumn": "active_time_hours",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_job_sessions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Pointer = Json.Document(File.Contents(SourceFolder & \"\\current.json\")),",
                "    Bundle = SourceFolder & \"\\\" & Text.Replace(Pointer[relative_folder], \"/\", \"\\\"),",
                "    Source = Csv.Document(File.Contents(Bundle & \"\\fact_job_sessions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"job_id\", Int64.Type}, {\"task_id\", Int64.Type}, {\"annotator_id\", type text}, {\"date_key\", type date}, {\"status\", type text}, {\"total_frames\", Int64.Type}, {\"total_objects\", Int64.Type}, {\"active_time_hours\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total_Completed_Frames",
            "expression": "COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = \"completed\"), 0)",
            "formatString": "#,0",
            "displayFolder": "KPI"
          },
          {
            "name": "Total_Objects_Created",
            "expression": "IF(MAX(report_status[annotations_available]) = 1, COALESCE(COUNTROWS(fact_annotations), 0))",
            "formatString": "#,0",
            "displayFolder": "KPI"
          },
          {
            "name": "Total_Active_Hours",
            "expression": "IF(COUNTROWS(fact_job_sessions) > 0 && COUNT(fact_job_sessions[active_time_hours]) = COUNTROWS(fact_job_sessions), SUM(fact_job_sessions[active_time_hours]))",
            "formatString": "0.00",
            "displayFolder": "KPI"
          },
          {
            "name": "Velocity_Frames_Per_Hour",
            "expression": "DIVIDE([Total_Completed_Frames], [Total_Active_Hours])",
            "formatString": "0.0",
            "displayFolder": "KPI"
          },
          {
            "name": "Velocity_Objects_Per_Hour",
            "expression": "DIVIDE([Total_Objects_Created], [Total_Active_Hours])",
            "formatString": "0.0",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_Time_Per_Frame_Mins",
            "expression": "DIVIDE([Total_Active_Hours] * 60, [Total_Completed_Frames])",
            "formatString": "0.00",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_Time_Per_Object_Secs",
            "expression": "DIVIDE([Total_Active_Hours] * 3600, [Total_Objects_Created])",
            "formatString": "0.00",
            "displayFolder": "KPI"
          },
          {
            "name": "First_Time_Pass_Rate",
            "expression": "IF(MAX(report_status[reviews_available]) = 1, DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_iteration] = 1, fact_qa_reviews[review_decision] = \"Accepted\"), 0), CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_iteration] = 1)))",
            "formatString": "0.0%",
            "displayFolder": "KPI"
          },
          {
            "name": "Rejection_Rate",
            "expression": "IF(MAX(report_status[reviews_available]) = 1, DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_qa_reviews), fact_qa_reviews[review_decision] = \"Rejected\"), 0), COUNTROWS(fact_qa_reviews)))",
            "formatString": "0.0%",
            "displayFolder": "KPI"
          },
          {
            "name": "Total_Defects",
            "expression": "IF(MAX(report_status[defects_available]) = 1, COALESCE(COUNTROWS(fact_qa_defects), 0))",
            "formatString": "#,0",
            "displayFolder": "KPI"
          },
          {
            "name": "Defect_Density_Per_100F",
            "expression": "DIVIDE([Total_Defects] * 100, [Total_Completed_Frames])",
            "formatString": "0.00",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_Defects_Per_Job",
            "expression": "DIVIDE([Total_Defects], DISTINCTCOUNT(fact_qa_reviews[job_id]))",
            "formatString": "0.00",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_mIoU_Score",
            "expression": "IF(MAX(report_status[gt_available]) = 1, AVERAGE(fact_ground_truth_eval[mean_iou]))",
            "formatString": "0.000",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_F1_Score",
            "expression": "IF(MAX(report_status[gt_available]) = 1, AVERAGE(fact_ground_truth_eval[f1_score]))",
            "formatString": "0.000",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_Object_Area_Pixels",
            "expression": "AVERAGE(fact_annotations[area_pixels])",
            "formatString": "#,0.0",
            "displayFolder": "KPI"
          },
          {
            "name": "Avg_Area_Frame_Pct",
            "expression": "DIVIDE(AVERAGE(fact_annotations[frame_area_pct]), 100)",
            "formatString": "0.00%",
            "displayFolder": "KPI"
          },
          {
            "name": "Pct_Small_Objects",
            "expression": "DIVIDE(COALESCE(CALCULATE(COUNTROWS(fact_annotations), fact_annotations[size_scale] = \"Small\"), 0), CALCULATE(COUNTROWS(fact_annotations), NOT ISBLANK(fact_annotations[size_scale])))",
            "formatString": "0.0%",
            "displayFolder": "KPI"
          },
          {
            "name": "Count_At_Risk_Annotators",
            "expression": "VAR People = ADDCOLUMNS(VALUES(dim_annotators[annotator_id]), \"F\", [First_Time_Pass_Rate], \"R\", [Rejection_Rate], \"G\", [Avg_F1_Score]) VAR Assessed = FILTER(People, NOT ISBLANK([F]) || NOT ISBLANK([R]) || NOT ISBLANK([G])) RETURN IF(COUNTROWS(Assessed) > 0, COALESCE(COUNTROWS(FILTER(Assessed, (NOT ISBLANK([F]) && [F] < 0.8) || (NOT ISBLANK([R]) && [R] >= 0.2) || (NOT ISBLANK([G]) && [G] < 0.85))), 0))",
            "formatString": "#,0",
            "displayFolder": "KPI"
          },
          {
            "name": "System_Avg_Velocity",
            "expression": "CALCULATE([Velocity_Frames_Per_Hour], REMOVEFILTERS(dim_annotators))",
            "formatString": "0.0",
            "displayFolder": "KPI"
          },
          {
            "name": "Project_Progress_Pct",
            "expression": "DIVIDE([Total_Completed_Frames], SUM(dim_tasks_batches[total_frames_target]))",
            "formatString": "0.0%",
            "displayFolder": "KPI"
          },
          {
            "name": "Total_Target_Frames",
            "expression": "SUM(dim_tasks_batches[total_frames_target])",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Frames_In_Annotation",
            "expression": "COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = \"annotation\"), 0)",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Frames_In_Validation",
            "expression": "COALESCE(CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = \"validation\"), 0)",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Daily_Completed_Frames",
            "expression": "CALCULATE(SUM(fact_job_sessions[total_frames]), fact_job_sessions[status] = \"completed\")",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Total_Open_Edge_Cases",
            "expression": "COALESCE(CALCULATE(COUNTROWS(fact_edge_cases), fact_edge_cases[state] = \"open\"), 0)",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Total_Blockers",
            "expression": "COALESCE(CALCULATE(COUNTROWS(fact_edge_cases), fact_edge_cases[state] = \"open\", fact_edge_cases[severity] = \"Blocker\"), 0)",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Active_Annotators",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(dim_annotators[annotator_id]), NOT ISBLANK(dim_annotators[annotator_id]) && CALCULATE(COUNTROWS(fact_job_sessions)) > 0)), 0)",
            "formatString": "#,0",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Source_Label",
            "expression": "IF(MAX(report_status[is_demo]) = 1, \"DEMO / DỮ LIỆU GIẢ LẬP\", \"DỮ LIỆU NGUỒN\") & \"  |  \" & FORMAT(MAX(report_status[as_of]), \"dd/MM/yyyy\")",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Data_Warnings",
            "expression": "\"Nguồn: \" & IF(ISBLANK([Total_Active_Hours]), \"giờ làm chưa đủ\", \"có giờ làm\") & \" | \" & IF(MAX(report_status[reviews_available]) = 1, \"có review\", \"thiếu review\") & \" | \" & IF(MAX(report_status[gt_available]) = 1, \"có Ground Truth\", \"thiếu Ground Truth\") & UNICHAR(10) & \"KPI trống = chưa đủ dữ liệu. Frames hoàn thành là proxy theo trạng thái job, chưa đồng nghĩa QA pass.\"",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Selected_Case",
            "expression": "SELECTEDVALUE(fact_edge_cases[description], \"Chọn một ca trong bảng phía trên để đọc mô tả. Link example.org trong bản DEMO chỉ dùng minh họa.\")",
            "displayFolder": "Report helpers"
          },
          {
            "name": "Annotator_Segment",
            "expression": "IF(HASONEVALUE(dim_annotators[annotator_id]) && NOT ISBLANK(SELECTEDVALUE(dim_annotators[annotator_id])), (VAR V = [Velocity_Frames_Per_Hour] VAR F = [First_Time_Pass_Rate] VAR R = [Rejection_Rate] VAR G = [Avg_F1_Score] VAR Known = NOT ISBLANK(F) || NOT ISBLANK(R) || NOT ISBLANK(G) VAR Risk = (NOT ISBLANK(F) && F < .8) || (NOT ISBLANK(R) && R >= .2) || (NOT ISBLANK(G) && G < .85) RETURN SWITCH(TRUE(), ISBLANK(V) || NOT Known, \"Insufficient data\", Risk && V >= 60, \"Fast and faulty\", Risk && V < 20, \"Needs retraining\", Risk, \"Needs QA support\", V < 20, \"Slow but steady\", V >= 40, \"Star annotator\", \"Core performer\")))",
            "displayFolder": "Report helpers"
          }
        ]
      },
      {
        "name": "fact_annotations",
        "columns": [
          {
            "name": "annotation_id",
            "dataType": "string",
            "sourceColumn": "annotation_id",
            "summarizeBy": "none",
            "isHidden": true
